#!/usr/bin/env python3
"""QEMU-only Wayland socket ACL probe; never a production authorization gate.

Positive control: exam UID can connect to the socket.
Negative control: unrelated unprivileged UID cannot traverse the private
runtime directory. Same-UID hostile clients remain an explicit open risk.
"""
import os
import pwd
import socket
import stat
import sys
from pathlib import Path

RUNTIME = Path("/run/safeexamos-exam")


def attempt(path, account):
    user = pwd.getpwnam(account)
    pid = os.fork()
    if pid == 0:
        try:
            os.setgroups([])
            os.setgid(user.pw_gid)
            os.setuid(user.pw_uid)
            conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            conn.settimeout(2)
            conn.connect(str(path))
            conn.close()
            os._exit(0)
        except (OSError, ValueError):
            os._exit(1)
    _, status = os.waitpid(pid, 0)
    return os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0


def main():
    if os.geteuid() != 0:
        return 2
    exam = pwd.getpwnam("exam")
    outsider = pwd.getpwnam("nobody")
    if exam.pw_uid == outsider.pw_uid:
        return 2
    try:
        root_stat = RUNTIME.lstat()
        if (not stat.S_ISDIR(root_stat.st_mode)
                or root_stat.st_uid != exam.pw_uid
                or stat.S_IMODE(root_stat.st_mode) != 0o700):
            return 1
        candidates = [p for p in RUNTIME.iterdir()
                      if p.name.startswith("wayland-") and
                      stat.S_ISSOCK(p.lstat().st_mode)]
        for path in candidates:
            info = path.lstat()
            if info.st_uid != exam.pw_uid:
                continue
            # A separate process with the same exam UID is intentionally
            # able to connect today. Record that vulnerability as evidence
            # until a separate-UID or compositor client-auth design exists.
            legitimate = attempt(path, "exam")
            other_uid_blocked = not attempt(path, "nobody")
            same_uid_untrusted_can_connect = attempt(path, "exam")
            if legitimate and other_uid_blocked and same_uid_untrusted_can_connect:
                print("SAFEEXAMOS_WAYLAND_ACL_EXAM_ALLOWED", flush=True)
                print("SAFEEXAMOS_WAYLAND_ACL_OUTSIDER_DENIED", flush=True)
                print("SAFEEXAMOS_WAYLAND_SAME_UID_GAP_CONFIRMED", flush=True)
                return 0
        return 1
    except (OSError, KeyError):
        return 1


if __name__ == "__main__":
    sys.exit(main())
