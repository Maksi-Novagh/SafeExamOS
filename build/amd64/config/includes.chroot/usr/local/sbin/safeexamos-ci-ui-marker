#!/bin/sh
set -eu

start=$(date +%s)
deadline=$(( start + 180 ))
reported=0

while [ "$(date +%s)" -lt "$deadline" ]; do
  # Native WebKitGTK has a separate QEMU boot flag and process marker.
  # The guest emits this only after the WebKit load-finished callback.
  if grep -Fq 'safeexamos.wayland_acl_ci=1' /proc/cmdline; then
    if python3 /usr/local/sbin/safeexamos-wayland-acl-probe; then
      printf '%s\n' 'SAFEEXAMOS_CI_WAYLAND_ACL_OK' > /dev/ttyS0 2>/dev/null || true
      exit 0
    fi
    # This boot must never exit through the ordinary launcher marker.
    sleep 1
    continue
  fi
  if grep -Fq 'safeexamos.native_handoff_ci=1' /proc/cmdline; then
    logs=$(journalctl -b -u safeexamos-kiosk.service --no-pager -n 250 2>/dev/null || true)
    if printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_BROWSER_TRANSITION=portal-to-native-lab' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_NATIVE_HANDOFF_CI_READY' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_BROWSER_DISPOSED=portal' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_BROWSER_DISPOSED=native-lab' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_BROWSER_TRANSITION=native-lab-to-portal' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_NATIVE_HANDOFF_CI_COMPLETE'; then
      printf '%s\n' 'SAFEEXAMOS_CI_NATIVE_HANDOFF_OK' > /dev/ttyS0 2>/dev/null || true
      exit 0
    fi
  fi
  if grep -Fq 'safeexamos.popups_ci=1' /proc/cmdline; then
    logs=$(journalctl -b -u safeexamos-kiosk.service --no-pager -n 160 2>/dev/null || true)
    if printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_NATIVE_SEB_POPUP_CREATE' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_NATIVE_SEB_CHILD_READY' &&
       printf '%s\n' "$logs" | grep -Fq 'SAFEEXAMOS_NATIVE_SEB_POPUP_DENIED'; then
      printf '%s\n' 'SAFEEXAMOS_CI_WEBKIT_POPUPS_OK' > /dev/ttyS0 2>/dev/null || true
      exit 0
    fi
  fi
  if ! grep -Eq 'safeexamos.(windows|popups)_ci=1' /proc/cmdline && journalctl -b -u safeexamos-kiosk.service --no-pager -n 35 2>/dev/null \
      | grep -Fq 'SAFEEXAMOS_NATIVE_SEB_UI_READY'; then
    printf '%s\n' 'SAFEEXAMOS_CI_NATIVE_SEB_OK' > /dev/ttyS0 2>/dev/null || true
    exit 0
  fi
  if grep -Fq 'safeexamos.windows_ci=1' /proc/cmdline; then
    if journalctl -b -u safeexamos-kiosk.service --no-pager -n 120 2>/dev/null |
       grep -Fq 'SAFEEXAMOS_NATIVE_SEB_CHILD_READY'; then
      printf '%s\n' 'SAFEEXAMOS_CI_MANAGED_WINDOWS_OK' > /dev/ttyS0 2>/dev/null || true
      exit 0
    fi
  fi
  cage_pid=$(pgrep -x cage 2>/dev/null | head -n 1 || true)
  chromium_pid=$(pgrep -x chromium 2>/dev/null | head -n 1 || true)

  if [ -n "$cage_pid" ] && [ -n "$chromium_pid" ]; then
    cmdline=$(tr '\0' ' ' < "/proc/$chromium_pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in
      *"/launcher/index.html"*)
        printf '%s\n' 'SAFEEXAMOS_CI_UI_OK' > /dev/ttyS0 2>/dev/null || true
        mkdir -p /run/safeexamos
        printf '%s\n' 'SAFEEXAMOS_CI_UI_OK' > /run/safeexamos/ci-ui-ok
        exit 0
        ;;
    esac
  fi

  if [ "$reported" -eq 0 ] && [ "$(date +%s)" -ge "$((start + 30))" ]; then
    reported=1
    {
      echo 'SAFEEXAMOS_CI_UI_DIAGNOSTIC'
      systemctl status safeexamos-kiosk.service --no-pager -l 2>&1 || true
      systemctl status seatd.service --no-pager -l 2>&1 || true
      ls -l /run/seatd.sock 2>&1 || true
      journalctl -u safeexamos-kiosk.service -b --no-pager -n 60 2>&1 || true
    } > /dev/ttyS0 2>/dev/null || true
  fi
  sleep 1
done

{
  echo 'SAFEEXAMOS_CI_UI_TIMEOUT'
  echo 'SAFEEXAMOS_CI_KIOSK_JOURNAL_BEGIN'
  journalctl -u safeexamos-kiosk.service -b --no-pager -n 90 2>&1 || true
  echo '--- seatd journal ---'
  journalctl -u seatd.service -b --no-pager -n 50 2>&1 || true
  echo 'SAFEEXAMOS_CI_KIOSK_JOURNAL_END'
} > /dev/ttyS0 2>/dev/null || true
exit 1
