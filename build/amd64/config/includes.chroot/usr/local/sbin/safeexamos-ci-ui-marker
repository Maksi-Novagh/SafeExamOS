#!/bin/sh
set -eu

deadline=$(( $(date +%s) + 90 ))

while [ "$(date +%s)" -lt "$deadline" ]; do
  cage_pid=$(pgrep -x cage 2>/dev/null | head -n 1 || true)
  chromium_pid=$(pgrep -x chromium 2>/dev/null | head -n 1 || true)

  if [ -n "$cage_pid" ] && [ -n "$chromium_pid" ]; then
    cmdline=$(tr '\0' ' ' < "/proc/$chromium_pid/cmdline" 2>/dev/null || true)
    case "$cmdline" in
      *"/launcher/index.html"*)
        printf '%s\n' 'SAFEEXAMOS_CI_UI_OK' > /dev/ttyS0 2>/dev/null || true
        mkdir -p /run/safeexamos
        printf '%s\n' 'SAFEEXAMOS_CI_UI_OK' > /run/safeexamos/ci-ui-ok
        exit 0
        ;;
    esac
  fi

  sleep 1
done

{
  echo 'SAFEEXAMOS_CI_UI_TIMEOUT'
  echo 'SAFEEXAMOS_CI_KIOSK_JOURNAL_BEGIN'
  journalctl -u safeexamos-kiosk.service -b --no-pager -n 90 2>&1 || true
  echo 'SAFEEXAMOS_CI_KIOSK_JOURNAL_END'
} > /dev/ttyS0 2>/dev/null || true
exit 1
