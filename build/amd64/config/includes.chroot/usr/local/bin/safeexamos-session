#!/bin/sh
set -eu

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=SafeExamOS
export XDG_SESSION_DESKTOP=SafeExamOS
export XKB_DEFAULT_LAYOUT="${SAFEEXAMOS_XKB_LAYOUT:-us}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

echo "SAFEEXAMOS_SESSION_START"
printf "SAFEEXAMOS_SESSION_USER=%s UID=%s RUNTIME=%s\n" "$(id -un)" "$(id -u)" "$XDG_RUNTIME_DIR"

RUNTIME_LAUNCHER="$XDG_RUNTIME_DIR/launcher"
mkdir -p "$RUNTIME_LAUNCHER" "${XDG_CACHE_HOME:-$XDG_RUNTIME_DIR/cache}"
chmod 0700 "${XDG_CACHE_HOME:-$XDG_RUNTIME_DIR/cache}"
echo "SAFEEXAMOS_WLR_RENDERER=${WLR_RENDERER:-auto}"
cp /usr/share/safeexamos/launcher/index.html "$RUNTIME_LAUNCHER/index.html"
cp /usr/share/safeexamos/launcher/demo.html "$RUNTIME_LAUNCHER/demo.html"
cp /usr/share/safeexamos/launcher/demo-exam.js "$RUNTIME_LAUNCHER/demo-exam.js"
cp /usr/share/safeexamos/launcher/preflight.js "$RUNTIME_LAUNCHER/preflight.js"
cp /usr/share/safeexamos/launcher/portals.js "$RUNTIME_LAUNCHER/portals.js"
cp /usr/share/safeexamos/launcher/portal-browser.js "$RUNTIME_LAUNCHER/portal-browser.js"
cp /usr/share/safeexamos/launcher/transition.js "$RUNTIME_LAUNCHER/transition.js"
echo "SAFEEXAMOS_PREFLIGHT_ASYNC_START"
(
  # Keep the snapshot current when DHCP finishes or the network changes.
  # Collection is bounded; on failure publish a fail-closed fallback.
  while :; do
    if timeout -k 2s 14s /usr/local/sbin/safeexamos-preflight "$RUNTIME_LAUNCHER"; then
      echo "SAFEEXAMOS_PREFLIGHT_OK"
    else
      echo "SAFEEXAMOS_PREFLIGHT_DEGRADED" >&2
      degraded=$(mktemp "$RUNTIME_LAUNCHER/.preflight-degraded.XXXXXX")
      cp /usr/share/safeexamos/launcher/preflight.js "$degraded"
      chmod 0644 "$degraded"
      mv -f "$degraded" "$RUNTIME_LAUNCHER/preflight.js"
    fi
    sleep 15
  done
) &
echo "SAFEEXAMOS_CAGE_START"
# Cage supervises the dedicated mode controller; only one Chromium child
# and one ephemeral browser profile exist at a time.
# Only QEMU tests booting with this explicit kernel parameter use the native
# offline page. Normal boot still starts Chromium and the school portal.
# Explicitly selected experimental stacked-window compositor.
# Never selected for normal Smartschool or normal Cage boot.
if grep -Eq '(^|[[:space:]])safeexamos.native_handoff_ci=1([[:space:]]|$)' /proc/cmdline; then
  export SAFEEXAMOS_NATIVE_SUPERVISOR_LAB=1
  export SAFEEXAMOS_NATIVE_HANDOFF_CI=1
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  echo "SAFEEXAMOS_NATIVE_HANDOFF_CI_START"
  exec cage -d -- /usr/local/bin/safeexamos-browser-supervisor
fi

if grep -Eq '(^|[[:space:]])safeexamos.popups_ci=1([[:space:]]|$)' /proc/cmdline; then
  export SAFEEXAMOS_NATIVE_CI=1
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  echo "SAFEEXAMOS_WEBKIT_POPUP_CI_START"
  exec labwc -C /etc/safeexamos/labwc -S "/usr/local/bin/safeexamos-linux-seb --config /usr/share/safeexamos/linux-seb-fixture.json --smoke-ui --smoke-windows --smoke-popups"
fi

if grep -Eq '(^|[[:space:]])safeexamos.windows_ci=1([[:space:]]|$)' /proc/cmdline; then
  export SAFEEXAMOS_NATIVE_CI=1
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  echo "SAFEEXAMOS_MANAGED_WINDOWS_CI_START"
  exec labwc -C /etc/safeexamos/labwc -S "/usr/local/bin/safeexamos-linux-seb --config /usr/share/safeexamos/linux-seb-fixture.json --smoke-ui --smoke-windows"
fi

if grep -Eq '(^|[[:space:]])safeexamos.native_ci=1([[:space:]]|$)' /proc/cmdline; then
  export SAFEEXAMOS_NATIVE_CI=1
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  echo "SAFEEXAMOS_NATIVE_SEB_CI_START"
  exec cage -d -- /usr/local/bin/safeexamos-linux-seb \
    --config /usr/share/safeexamos/linux-seb-fixture.json --smoke-ui
fi

# Lab-only supervised native browser is disabled unless explicitly booted.
if grep -Eq '(^|[[:space:]])safeexamos.native_supervisor_lab=1([[:space:]]|$)' /proc/cmdline; then
  export SAFEEXAMOS_NATIVE_SUPERVISOR_LAB=1
  echo "SAFEEXAMOS_NATIVE_SUPERVISOR_LAB_ENABLED"
fi
exec cage -d -- /usr/local/bin/safeexamos-browser-supervisor
